# Plantilla de .env.local (nunca se versiona: .gitignore ignora .env*). Sin valores reales acá.
# Columna entre corchetes: [navegador] = viaja al bundle público (solo valores públicos);
# [servidor] = solo Node/Next en el servidor; [scripts] = solo scripts de seed y pruebas.
# Supabase local: `npm run db:start && npm run demo:configure` crea .env.local con las claves de esa instancia.
# Vercel: las mismas variables se cargan en el panel del proyecto (Preview/Production), nunca en el repo.

# --- Supabase (obligatorias para todo salvo /design-system) ---
# [navegador] URL del proyecto (local: http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=
# [navegador] Clave PUBLICABLE (anon/publishable). Nunca la service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# [servidor][scripts] Secreta. La usan los seeds y /api/team (alta de cuentas del equipo y cambio de clave temporal).
# Nunca NEXT_PUBLIC_*, nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# [servidor] Origen permitido para POST (CSRF). Local: http://127.0.0.1:3000. En Vercel, el dominio del entorno.
APP_ORIGIN=http://127.0.0.1:3000
# [servidor] Muestra los rótulos de demo (menús de demostración, montos simulados).
DEMO_MODE=true
# [servidor] true = el área cliente exige cuenta con perfil. Con true, la base también necesita
# private.configuration.accounts_required=true (migración 021).
ACCOUNTS_REQUIRED=
# [servidor] Catálogo interno /design-system. false en despliegues compartidos.
ENABLE_DESIGN_SYSTEM=false

# --- Pagos (solo simulados) ---
# [servidor] mock es el único proveedor habilitado; BAC falla a propósito hasta tener acuerdo y manual.
PAYMENT_PROVIDER=mock
# [servidor] Debe quedar en false. No hay cobros reales.
REAL_PAYMENTS_ENABLED=false
# [servidor] Solo pruebas: resultados simulados (rechazo, timeout). La base los rechaza salvo allow_scenarios=true (021).
ENABLE_PAYMENT_SCENARIOS=

# --- Ticket de retiro ---
# [servidor] Secreta. Cifra el QR/código privado. Generar una vez:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PICKUP_TOKEN_ENCRYPTION_KEY=
# [servidor] Versión de la clave actual; va dentro de cada ticket cifrado. Cambiarla deja ilegibles los tickets abiertos
# (todavía no hay rotación con dos claves).
PICKUP_TOKEN_KEY_VERSION=1

# --- Cuentas de demo (solo `npm run demo:seed-users` y pruebas en vivo; no producción) ---
# [scripts] Contraseñas fuertes (12+ caracteres) y correos distintos para cada rol.
DEMO_BARTENDER_EMAIL=
DEMO_BARTENDER_PASSWORD=
DEMO_BARTENDER_2_EMAIL=
DEMO_BARTENDER_2_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
# [scripts] Opcional: administración global de Onza.
DEMO_ONZA_EMAIL=
DEMO_ONZA_PASSWORD=
# [scripts] Cuenta personal (cliente), distinta de todas las del equipo.
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PASSWORD=
# [scripts] true solo contra una base de demo descartable (`npm run test:e2e:live`).
E2E_LIVE=false

# Variables solo de línea de comandos (no van en este archivo): ONZA_APP, SHIM_URL y SHIM_PORT (scripts de verificación
# contra scripts/local-shim), PLAYWRIGHT_CHROMIUM y CHROMIUM_PATH (navegador propio para Playwright).
