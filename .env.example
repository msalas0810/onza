# Dedicated demo. Supabase local: npm run db:start && npm run demo:configure
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Only used by scripts/seed-users.mjs, never by the web runtime.
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://127.0.0.1:3000
DEMO_MODE=true
PAYMENT_PROVIDER=mock
REAL_PAYMENTS_ENABLED=false
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PICKUP_TOKEN_ENCRYPTION_KEY=
PICKUP_TOKEN_KEY_VERSION=1
# Strong dedicated demo accounts, not production. Optional Onza global admin.
DEMO_BARTENDER_EMAIL=
DEMO_BARTENDER_PASSWORD=
DEMO_BARTENDER_2_EMAIL=
DEMO_BARTENDER_2_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_ONZA_EMAIL=
DEMO_ONZA_PASSWORD=
# Run live tests only against a disposable demo database.
E2E_LIVE=false
# Internal catalogue is available in development; keep false for shared deployments.
ENABLE_DESIGN_SYSTEM=false
