# Dedicated demo. Supabase local: npm run db:start && npm run demo:configure
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Lo usan los scripts de seed y la ruta /api/team (alta de cuentas laborales y cierre del cambio de
# contraseña temporal). Nunca NEXT_PUBLIC_*, nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://127.0.0.1:3000
DEMO_MODE=true
PAYMENT_PROVIDER=mock
REAL_PAYMENTS_ENABLED=false
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PICKUP_TOKEN_ENCRYPTION_KEY=
PICKUP_TOKEN_KEY_VERSION=1
# Strong dedicated demo accounts, not production. Optional Onza global admin.
DEMO_BARTENDER_EMAIL=
DEMO_BARTENDER_PASSWORD=
DEMO_BARTENDER_2_EMAIL=
DEMO_BARTENDER_2_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_ONZA_EMAIL=
DEMO_ONZA_PASSWORD=
# Personal demo account (different email from every staff account).
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PASSWORD=
# Run live tests only against a disposable demo database.
E2E_LIVE=false
# Internal catalogue is available in development; keep false for shared deployments.
ENABLE_DESIGN_SYSTEM=false
# Login required for the customer area (customer accounts + onboarding). Leave unset/false until
# migration 202611170010 is applied: without it the demo keeps the guest flow.
# Con true, la base también debe tener private.configuration.accounts_required=true (migración 021): la regla vale por RPC directa.
ACCOUNTS_REQUIRED=
# Tests only: allow simulated payment outcomes. Never true in a shared deployment.
# Solo pruebas. La base los rechaza salvo private.configuration.allow_scenarios=true (migración 021). Nunca en un entorno compartido.
ENABLE_PAYMENT_SCENARIOS=
