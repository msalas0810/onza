{
  "name": "onza",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript > src/lib/supabase/database.generated.ts",
    "demo:seed-users": "node --env-file=.env.local scripts/seed-users.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "demo:configure": "node scripts/configure-local.mjs",
    "db:types:offline": "node scripts/generate-db-types.mjs",
    "format": "prettier --write src tests scripts/*.mjs",
    "test:e2e:live": "node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "demo:configure:hosted": "node scripts/configure-hosted.mjs",
    "verify:hosted:security": "node --env-file=.env.local scripts/verify-hosted-security.mjs",
    "verify:hosted:ui": "node --env-file=.env.local scripts/inspect-hosted-ui.mjs",
    "demo:seed-venue-images": "node --env-file=.env.local scripts/seed-venue-images.mjs",
    "demo:generate-venue-art": "node scripts/generate-venue-placeholders.mjs",
    "demo:seed-product-images": "node --env-file=.env.local scripts/seed-product-images.mjs",
    "demo:generate-drink-art": "node scripts/generate-product-illustrations.mjs",
    "demo:seed-real-venues": "node --env-file=.env.local scripts/seed-real-venues.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "node": "24.22.3",
    "prettier": "3.10.1",
    "supabase": "3.1.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "type": "module",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
